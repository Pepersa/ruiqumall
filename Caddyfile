{$RUIQU_CADDY_SITE_ADDRESS::80} {
    encode gzip

    handle_path /static/* {
        root * /srv/ruiqu/staticfiles
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle_path /media/* {
        root * /srv/ruiqu/media
        file_server
    }

    reverse_proxy web:8000 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
    }
}
